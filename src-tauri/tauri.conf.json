{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Presentation",
  "version": "0.1.0",
  "identifier": "app.powercore.gh-presentation",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://127.0.0.1:18080/ui/wizard.html"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "GitHub account presentation analyzer",
    "longDescription": "Connect GitHub, scan your repos, and improve how they present — PowerCore.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
